---
import Base from '../layouts/Base.astro';

// Pricing and specifics are placeholders for the content pass.
const services = [
  {
    idx: '01',
    title: 'Cyber Security',
    tagline: 'Get serious about security without building a security org.',
    body:
      'Threat modelling, security reviews, penetration-test triage, and practical hardening. I help teams understand their real risk and fix what actually matters — not chase a checklist.',
    includes: [
      'Architecture & threat modelling',
      'Code and infrastructure security review',
      'Incident readiness & response planning',
      'Security training for engineering teams',
    ],
    price: 'Flat-rate engagement · scoped per project',
  },
  {
    idx: '02',
    title: 'Technology & Security for Startups',
    tagline: "The CTO your startup can't hire yet.",
    body:
      'Step-in, director-level technology leadership for founders. I own the calls a CTO or Director of Engineering owns — architecture, build-versus-buy, security posture, hiring and team structure — making the expensive decisions right, and early, so you can move fast without boxing yourself in.',
    includes: [
      'Fractional CTO / Director of Engineering',
      'Architecture & technical due diligence',
      'Build vs. buy & vendor decisions',
      'Security posture, roadmap & hiring',
    ],
    price: 'Flat-rate retainer or project · scoped to stage',
  },
  {
    idx: '03',
    title: 'Software & Application Development',
    tagline: 'Production software that ships and holds up.',
    body:
      'Design and delivery of real software — greenfield products, internal tools, and the awkward integrations nobody else wants to own. Built to be maintained, not just demoed.',
    includes: [
      'Web & desktop application development',
      'APIs, automation & systems integration',
      'Greenfield product builds',
      'Rescue & refactor of inherited codebases',
    ],
    price: 'Flat-rate project · fixed scope, fixed price',
  },
];

const process = [
  { n: '01', t: 'Conversation', d: 'A no-charge call to understand the problem and whether I am the right person for it.' },
  { n: '02', t: 'Scope & quote', d: 'A written scope with a flat price — you know the cost before any work begins.' },
  { n: '03', t: 'Delivery', d: 'Focused, communicated work with regular checkpoints. No surprises, no scope creep.' },
  { n: '04', t: 'Handover', d: 'Documentation and a clean handover so your team can run with it independently.' },
];
---

<Base title="Services" description="Flat-rate consultancy from Leo Childs — cyber security, startup technology & security, and software development.">
  <section class="services-hero wrap">
    <p class="eyebrow reveal"><span class="idx">ENGAGE</span> Services</p>
    <h1 class="h-display reveal" style="animation-delay: 0.1s">
      Flat-rate consultancy.
    </h1>
    <p class="lead reveal" style="animation-delay: 0.18s">
      Three ways to work together. Fixed scope, fixed price, no hourly meter
      running in the background — you know what you are paying before we start.
    </p>
  </section>

  <section class="section">
    <div class="wrap services-list">
      {services.map((s) => (
        <article class="svc card">
          <div class="svc-left">
            <span class="svc-idx mono">{s.idx}</span>
            <h2>{s.title}</h2>
            <p class="svc-tagline">{s.tagline}</p>
            <p class="svc-body">{s.body}</p>
            <p class="svc-price mono">{s.price}</p>
            <a href="/contact" class="btn">Enquire <span class="arrow">→</span></a>
          </div>
          <div class="svc-right">
            <span class="svc-includes-head mono">Includes</span>
            <ul class="svc-includes">
              {s.includes.map((i) => (
                <li><span class="tick" aria-hidden="true">◆</span>{i}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow"><span class="idx">04</span> How I work</p>
      <h2 class="h-section">Simple, honest, predictable.</h2>
      <div class="process-grid">
        {process.map((p) => (
          <div class="proc">
            <span class="proc-n mono">{p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta-section">
    <div class="wrap cta-inner">
      <h2 class="h-section">Tell me what<br />you're building.</h2>
      <div>
        <p class="prose">
          Every engagement starts with a conversation. No charge, no obligation —
          just a clear answer on whether I can help and what it would take.
        </p>
        <div class="btn-row">
          <a href="mailto:github.outthink378@passmail.net" class="btn btn--primary">
            Start a conversation <span class="arrow">→</span>
          </a>
          <a href="/contact" class="btn">All channels</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .services-hero {
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: 1rem;
  }
  .services-hero h1 { margin: 1.2rem 0; }

  .services-list { display: flex; flex-direction: column; gap: 1.25rem; }

  .svc {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2.5rem;
    padding: 2rem;
  }
  .svc:hover { transform: none; }
  .svc-idx { color: var(--accent); font-size: 0.72rem; }
  .svc h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    margin: 0.9rem 0 0.5rem;
  }
  .svc-tagline {
    color: var(--accent-bright);
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }
  .svc-body {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 52ch;
  }
  .svc-price {
    color: var(--muted);
    font-size: 0.62rem;
    text-transform: none;
    letter-spacing: 0.04em;
    margin-bottom: 1.5rem;
  }

  .svc-right {
    border-left: 1px solid var(--line);
    padding-left: 2.5rem;
  }
  .svc-includes-head { color: var(--muted); display: block; margin-bottom: 1rem; }
  .svc-includes { list-style: none; display: flex; flex-direction: column; gap: 0.7rem; }
  .svc-includes li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--text-dim);
  }
  .tick { color: var(--accent); font-size: 0.55rem; flex-shrink: 0; }

  @media (max-width: 760px) {
    .svc { grid-template-columns: 1fr; gap: 1.75rem; padding: 1.6rem; }
    .svc-right { border-left: none; border-top: 1px solid var(--line); padding-left: 0; padding-top: 1.5rem; }
  }

  /* process */
  .h-section { margin: 0.9rem 0 2.25rem; }
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .proc { background: var(--bg-1); padding: 1.5rem; }
  .proc-n { color: var(--accent); font-size: 0.72rem; }
  .proc h3 { font-size: 1.05rem; margin: 0.9rem 0 0.5rem; }
  .proc p { color: var(--text-dim); font-size: 0.88rem; line-height: 1.55; }
  @media (max-width: 760px) {
    .process-grid { grid-template-columns: 1fr; }
  }

  .cta-section {
    background: radial-gradient(ellipse 70% 120% at 0% 50%, var(--accent-faint), transparent 60%);
  }
  .cta-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .cta-inner .prose { margin-bottom: 1.5rem; }
  @media (max-width: 760px) {
    .cta-inner { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
