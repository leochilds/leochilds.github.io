---
import Base from '../layouts/Base.astro';

const services = [
  {
    idx: '01',
    title: 'Cyber Security',
    blurb:
      'Threat modelling, security reviews, and hardening for teams that need to get serious without building a security org overnight.',
  },
  {
    idx: '02',
    title: 'Tech & Security for Startups',
    blurb:
      'Fractional engineering leadership for new ventures — architecture, security posture, and the right call on what to build versus buy.',
  },
  {
    idx: '03',
    title: 'Software & Application Development',
    blurb:
      'Design and delivery of production software, from greenfield products to the awkward integrations nobody else wants to touch.',
  },
];

const selected = [
  {
    name: 'Cryptography Course',
    org: 'Kyri & Cou',
    badge: 'Course',
    badgeClass: 'badge--course',
    blurb:
      'A free YouTube cryptography course with an interactive companion site — play with ciphers and breaking tools lesson by lesson.',
    href: 'https://kyri-cou.github.io/cryptography/',
  },
  {
    name: 'malwi',
    org: 'Security research',
    badge: 'Live',
    badgeClass: 'badge--live',
    blurb:
      'Runtime malware detection that intercepts Python, Node and Bash code as it executes — catching supply-chain attacks in the act.',
    href: 'https://github.com/leochilds/malwi-1',
  },
  {
    name: 'LionPDF',
    org: 'Open source',
    badge: 'Live',
    badgeClass: 'badge--live',
    blurb:
      'A privacy-first desktop PDF reader built with Tauri, Rust and React. Local by default, nothing phones home.',
    href: 'https://github.com/leochilds/LionPDF',
  },
];
---

<Base title="Home">
  <!-- ============ HERO ============ -->
  <section class="hero wrap">
    <p class="eyebrow reveal" style="animation-delay: 0.05s">
      <span class="idx">PORTFOLIO</span> · SERVICES · FIELD NOTES
    </p>

    <h1 class="h-display hero-title reveal" style="animation-delay: 0.12s">
      I fix what's broken<br />
      and build what<br />
      <span class="accent">works better.</span>
    </h1>

    <p class="lead reveal" style="animation-delay: 0.22s">
      Engineer — not as a job title, as a way of thinking. I work across
      security, software, and systems, mostly with new ventures who need it
      done right the first time.
    </p>

    <div class="btn-row reveal" style="animation-delay: 0.3s">
      <a href="/services" class="btn btn--primary">
        Work with me <span class="arrow">→</span>
      </a>
      <a href="/work" class="btn">Selected work</a>
    </div>

    <dl class="hero-stats reveal" style="animation-delay: 0.4s">
      <div>
        <dt class="mono">Discipline</dt>
        <dd>Security · Software · Systems</dd>
      </div>
      <div>
        <dt class="mono">Engagements</dt>
        <dd>Flat-rate, scoped per project</dd>
      </div>
      <div>
        <dt class="mono">Based</dt>
        <dd>United Kingdom · Remote</dd>
      </div>
    </dl>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">01</span> Services</p>
        <a href="/services" class="head-link mono">All services →</a>
      </div>
      <h2 class="h-section">Flat-rate consultancy, no surprises.</h2>

      <div class="grid-3">
        {services.map((s) => (
          <a href="/services" class="card service-card">
            <span class="service-idx mono">{s.idx}</span>
            <h3>{s.title}</h3>
            <p>{s.blurb}</p>
            <span class="card-cta mono">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SELECTED WORK ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">02</span> Selected work</p>
        <a href="/work" class="head-link mono">Full index →</a>
      </div>
      <h2 class="h-section">Projects of note.</h2>

      <div class="grid-3">
        {selected.map((p) => (
          <a href={p.href} class="card work-card" target="_blank" rel="noopener noreferrer">
            <div class="work-top">
              <span class={`badge ${p.badgeClass}`}>{p.badge}</span>
              <span class="work-org mono">{p.org}</span>
            </div>
            <h3>{p.name}</h3>
            <p>{p.blurb}</p>
            <span class="card-cta mono">Visit →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CONTACT CTA ============ -->
  <section class="section cta-section">
    <div class="wrap cta-inner">
      <div>
        <p class="eyebrow"><span class="idx">03</span> Contact</p>
        <h2 class="h-section">Have a problem<br />worth solving?</h2>
      </div>
      <div class="cta-right">
        <p class="prose">
          Whether it's a security review, a startup that needs technical
          ballast, or software that has to ship — tell me what you're working on.
        </p>
        <div class="btn-row">
          <a href="mailto:github.outthink378@passmail.net" class="btn btn--primary">
            github.outthink378@passmail.net <span class="arrow">→</span>
          </a>
          <a href="/contact" class="btn">All channels</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-top: clamp(3.5rem, 9vw, 7rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .hero-title {
    margin: 1.4rem 0 1.6rem;
    max-width: 16ch;
  }
  .hero-title .accent {
    color: var(--accent);
    position: relative;
  }
  .lead { margin-bottom: 2rem; }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    max-width: 760px;
  }
  .hero-stats dt {
    font-size: 0.6rem;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .hero-stats dd {
    font-size: 0.92rem;
    color: var(--text);
    font-weight: 500;
  }
  @media (max-width: 600px) {
    .hero-stats { grid-template-columns: 1fr; gap: 1rem; }
  }

  /* ---- Section heads ---- */
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .head-link { color: var(--muted); }
  .head-link:hover { color: var(--accent); }
  .h-section { margin-bottom: 2.25rem; }

  /* ---- Grids ---- */
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 820px) { .grid-3 { grid-template-columns: 1fr; } }

  /* ---- Service cards ---- */
  .service-card { display: flex; flex-direction: column; min-height: 220px; }
  .service-card .service-idx {
    color: var(--accent);
    font-size: 0.72rem;
    margin-bottom: 1.2rem;
  }
  .service-card h3 { font-size: 1.2rem; margin-bottom: 0.6rem; }
  .service-card p {
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.55;
    flex: 1;
  }
  .card-cta {
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.64rem;
    transition: color 0.2s;
  }
  .card:hover .card-cta { color: var(--accent); }

  /* ---- Work cards ---- */
  .work-card { display: flex; flex-direction: column; min-height: 230px; }
  .work-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }
  .work-org { font-size: 0.62rem; color: var(--muted); }
  .work-card h3 { font-size: 1.2rem; margin-bottom: 0.6rem; color: var(--text); }
  .work-card p {
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.55;
    flex: 1;
  }

  /* ---- CTA ---- */
  .cta-section {
    background:
      radial-gradient(ellipse 70% 120% at 0% 50%, var(--accent-faint), transparent 60%);
  }
  .cta-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .cta-right .prose { margin-bottom: 1.5rem; }
  @media (max-width: 760px) {
    .cta-inner { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
