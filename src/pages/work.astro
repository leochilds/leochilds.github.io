---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

// NOTE: "Current focus" is real, confirmed content. Sections below it still
// contain curated real projects plus a few [placeholder] entries to replace
// in later content passes. Quality over coverage.

// --- Current focus: the two most relevant active projects ---
const focus = [
  {
    name: 'Cryptography Course',
    meta: 'Kyri & Cou · live',
    status: 'course',
    description:
      'A free YouTube cryptography series with a companion site that makes every episode hands-on. Each new video adds an interactive page for the concept it covers — the latest, on S-DES, runs all eight bits through every step of the cipher so you can change the input and watch the change propagate. The site builds from Caesar and Vigenère up through one-time pads, WEP and DES, with breaking tools alongside each cipher.',
    tags: ['Cryptography', 'Education', 'Interactive'],
    href: '/work/cryptography',
    liveUrl: 'https://kyri-cou.github.io/cryptography/',
    youtubeUrl: 'https://www.youtube.com/@KyriAndCou',
  },
  {
    name: 'Video Training Studio',
    meta: 'Private · the engine room',
    status: 'private',
    description:
      'The engine behind the course: a pipeline of open-source and custom tooling. Manim renders the animations, a local build of Piper Recording Studio captures my real voice, and VoxCPM generates fast AI-voiced drafts so timing is locked before I record. Animate → draft → record → auto re-time. Private because it holds the raw construction of the videos — my IP — not because the tooling is secret.',
    tags: ['Manim', 'Piper Studio', 'VoxCPM', 'Python'],
    href: '/work/cryptography',
  },
];

const ofNote = [
  {
    name: 'Canvas Computing',
    meta: 'Affiliation · security',
    status: 'company',
    statusLabel: 'Affiliation',
    description:
      "I'm part of Canvas Computing, the team behind malwi — AI-driven detection of malicious code. I contribute where I can and work closely with its maintainer; just as important, I can vouch for these tools from the inside, relying on them in a private security context I'm not able to name.",
    tags: ['Security', 'AI', 'Rust'],
    href: 'https://github.com/canvascomputing',
  },
  {
    name: 'Security utilities dashboard',
    meta: 'Private',
    status: 'private',
    description:
      'A native desktop dashboard, written in Rust, that gathers a set of small security-oriented utilities behind a single launchpad — open several tools side by side to prototype and demonstrate ideas. Built privately.',
    tags: ['Rust', 'Slint', 'Security'],
  },
  {
    name: 'End-to-end encrypted chat',
    meta: 'Private',
    status: 'private',
    description:
      'A secure, real-time chat application built entirely on serverless AWS — WebSocket APIs, Lambda, DynamoDB, CDK — with confidentiality and integrity as the design priority. Built privately.',
    tags: ['AWS', 'Serverless', 'Security'],
  },
  {
    name: 'Security-certification auditing',
    meta: 'Private',
    status: 'private',
    description:
      "An AI agent that audits suppliers' security certifications — focused on ISO 27001 and SOC 2 — researching the web, extracting findings, and tracking certification expiry automatically. Built privately.",
    tags: ['AI', 'Compliance', 'Python'],
  },
  {
    name: 'learnyounode walkthrough',
    meta: 'Archived · ★59',
    status: 'archived',
    description:
      'Homemade walkthroughs for the learnyounode Node.js exercises — my most-starred project, from the Founders & Coders second cohort. A marker of how far back my technical teaching goes; the work stands on its own.',
    tags: ['Node.js', 'Teaching'],
    href: 'https://github.com/leochilds/learnyounode-walkthrough',
    liveUrl: 'https://leochilds.github.io/learnyounode-walkthrough/',
  },
];

const tooling = [
  {
    name: 'web-to-markdown-crawler',
    meta: 'Open source',
    status: 'live',
    description:
      'A crawler that converts site contents to clean markdown and rewrites relative links — useful for feeding documentation to LLMs.',
    tags: ['TypeScript'],
    href: 'https://github.com/leochilds/web-to-markdown-crawler',
  },
  {
    name: 'serverless-event-driven-starter',
    meta: 'Open source',
    status: 'live',
    description:
      'A production-ready serverless event-driven starter using AWS CDK, Lambda and SvelteKit.',
    tags: ['TypeScript', 'AWS CDK', 'Svelte'],
    href: 'https://github.com/leochilds/serverless-event-driven-starter-app',
  },
  {
    name: 'typescript-starter',
    meta: 'Open source · ★1',
    status: 'live',
    description:
      'A TypeScript starter template with sensible defaults — the base I reach for when spinning up something new.',
    tags: ['TypeScript', 'Shell'],
    href: 'https://github.com/leochilds/typescript-starter',
  },
];

const beyond = [
  {
    name: '[Company / venture]',
    meta: 'Founded · placeholder',
    status: 'company',
    description:
      'Placeholder for a company or organisation you founded, built up, and handed on. A line on what it did and the role you played.',
    tags: ['Founder'],
  },
  {
    name: 'Geospatial & civil engineering',
    meta: 'Field work · placeholder',
    status: 'company',
    statusLabel: 'Field',
    description:
      'Placeholder for non-software engineering work — surveying geodetic data on construction sites, bringing software thinking into civil projects.',
    tags: ['Surveying', 'Engineering'],
  },
  {
    name: 'Teaching & curriculum',
    meta: 'Education · placeholder',
    status: 'course',
    statusLabel: 'Teaching',
    description:
      'Placeholder for in-person and online teaching — what you taught, to whom, and any materials worth linking.',
    tags: ['Education'],
  },
];

const sections = [
  { idx: '02', title: 'Projects of note', desc: 'Work I would point to first — including private and archived.', items: ofNote },
  { idx: '03', title: 'Tooling & open source', desc: 'Smaller public repositories and starters.', items: tooling },
  { idx: '04', title: 'Beyond GitHub', desc: 'Engineering that does not live in a repository.', items: beyond },
];
---

<Base title="Work" description="Selected work by Leo Childs — a free cryptography course and the studio behind it, plus security and software projects of note.">
  <section class="work-hero wrap">
    <p class="eyebrow reveal"><span class="idx">INDEX</span> Work</p>
    <h1 class="h-display reveal" style="animation-delay: 0.1s">Selected work.</h1>
    <p class="lead reveal" style="animation-delay: 0.18s">
      A curated set, not a feed. Focused projects of note — current and
      archived, public and private, code and otherwise.
    </p>
  </section>

  <!-- ============ CURRENT FOCUS ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">01</span> Current focus</p>
        <span class="head-note mono">A free cryptography course — and the studio that produces it.</span>
      </div>

      <div class="focus-grid">
        {focus.map((item) => (
          <ProjectCard
            name={item.name}
            description={item.description}
            meta={item.meta}
            status={item.status as any}
            tags={item.tags}
            href={(item as any).href}
            liveUrl={(item as any).liveUrl}
            youtubeUrl={(item as any).youtubeUrl}
          />
        ))}
      </div>

      <aside class="moat">
        <span class="moat-label mono">// the moat</span>
        <p class="moat-statement">
          Working with AI — <span class="accent">not behind it.</span>
        </p>
        <div class="moat-body">
          <p>
            In an age of vibe-coding, anyone can point a model at the same tools.
            The advantage was never the AI; it's the human input — deep
            experience in how people actually learn, real knowledge of the
            subject, and the judgement to catch the model when it's confidently
            wrong. The AI is a strong coder with vast knowledge, but like a
            person it makes mistakes, so we check each other, continuously.
          </p>
          <p>
            I shape the tools as much as I use them: customising each one to fit
            how I work, and contributing improvements back upstream where the
            original project would benefit. What can't be automated is the
            teaching instinct, the eye for what lands with a human viewer, and —
            where it counts — the voice, which is mine, recorded, not generated.
          </p>
        </div>
        <a href="/work/cryptography" class="moat-link mono">See it in practice →</a>
      </aside>
    </div>
  </section>

  {sections.map((section) => (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow"><span class="idx">{section.idx}</span> {section.title}</p>
          <span class="head-note mono">{section.desc}</span>
        </div>
        <div class="work-grid">
          {section.items.map((item) => (
            <ProjectCard
              name={item.name}
              description={item.description}
              meta={item.meta}
              status={item.status as any}
              statusLabel={(item as any).statusLabel}
              tags={item.tags}
              href={(item as any).href}
              liveUrl={(item as any).liveUrl}
              youtubeUrl={(item as any).youtubeUrl}
            />
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap more-line">
      <p class="prose">
        More public repositories live on GitHub — this page is the edit, not the
        archive.
      </p>
      <a href="https://github.com/leochilds" class="btn" target="_blank" rel="noopener noreferrer">
        GitHub <span class="arrow">↗</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .work-hero {
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: 1rem;
  }
  .work-hero h1 { margin: 1.2rem 0 1.2rem; }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }
  .head-note {
    font-size: 0.62rem;
    color: var(--muted);
    text-transform: none;
    letter-spacing: 0.04em;
    max-width: 36ch;
    text-align: right;
  }

  /* Current focus — two larger flagship cards */
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .focus-grid :global(.pcard) { min-height: 300px; }
  .focus-grid :global(.pcard-name) { font-size: 1.45rem; }
  .focus-grid :global(.pcard-desc) { font-size: 0.96rem; }

  /* Moat statement */
  .moat {
    margin-top: 1rem;
    padding: 2.25rem clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius);
    background:
      radial-gradient(ellipse 80% 160% at 0% 0%, var(--accent-faint), transparent 55%),
      var(--bg-1);
  }
  .moat-label { color: var(--accent); display: block; margin-bottom: 1rem; }
  .moat-statement {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin-bottom: 1rem;
  }
  .moat-statement .accent { color: var(--accent); }
  .moat-body {
    color: var(--text-dim);
    max-width: 64ch;
    line-height: 1.7;
  }
  .moat-body p { margin-bottom: 1rem; }
  .moat-body p:last-child { margin-bottom: 0; }
  .moat-link { display: inline-block; margin-top: 1.4rem; color: var(--accent); font-size: 0.66rem; }
  .moat-link:hover { color: var(--accent-bright); }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  @media (max-width: 820px) {
    .focus-grid { grid-template-columns: 1fr; }
    .work-grid { grid-template-columns: 1fr; }
    .head-note { text-align: left; }
  }

  .more-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
</style>
