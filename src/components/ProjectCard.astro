---
interface Props {
  name: string;
  description: string;
  meta?: string;          // org / context line, e.g. "Open source" or "Private · 2023"
  status?: 'live' | 'archived' | 'private' | 'course' | 'company';
  statusLabel?: string;   // override badge text
  tags?: string[];
  href?: string;          // primary link (repo or external)
  liveUrl?: string;
  youtubeUrl?: string;
  featured?: boolean;
}

const {
  name,
  description,
  meta,
  status,
  statusLabel,
  tags = [],
  href,
  liveUrl,
  youtubeUrl,
  featured = false,
} = Astro.props;

const statusText =
  statusLabel ??
  (status
    ? { live: 'Live', archived: 'Archived', private: 'Private', course: 'Course', company: 'Company' }[status]
    : null);
---

<div class:list={['card', 'pcard', { 'pcard--featured': featured, 'pcard--link': !!href }]}>
  {href && (
    <a
      class="pcard-overlay"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${name} — open`}
    ></a>
  )}

  <div class="pcard-top">
    {statusText && <span class={`badge badge--${status ?? 'live'}`}>{statusText}</span>}
    {meta && <span class="pcard-meta mono">{meta}</span>}
  </div>

  <h3 class="pcard-name">{name}</h3>
  {description && <p class="pcard-desc">{description}</p>}

  {tags.length > 0 && (
    <div class="tag-row pcard-tags">
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  )}

  <div class="pcard-links">
    {href && <span class="pcard-cta mono">View →</span>}
    {liveUrl && (
      <a class="pcard-link mono" href={liveUrl} target="_blank" rel="noopener noreferrer">Live ↗</a>
    )}
    {youtubeUrl && (
      <a class="pcard-link mono yt" href={youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube ↗</a>
    )}
  </div>
</div>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    min-height: 220px;
    color: inherit;
  }

  /* stretched primary link — covers the card without nesting anchors */
  .pcard-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .pcard--featured {
    border-color: var(--accent-dim);
    background:
      radial-gradient(ellipse 90% 140% at 0% 0%, var(--accent-faint), transparent 55%),
      var(--bg-1);
  }

  .pcard-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
    min-height: 1.2rem;
  }
  .pcard-meta { font-size: 0.6rem; color: var(--muted); }

  .pcard-name {
    font-size: 1.2rem;
    margin-bottom: 0.55rem;
    color: var(--text);
  }
  .pcard--link:hover .pcard-name { color: var(--accent-bright); }

  .pcard-desc {
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.55;
    flex: 1;
  }

  .pcard-tags { margin-top: 1rem; position: relative; z-index: 2; }

  .pcard-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.1rem;
    position: relative;
    z-index: 2;
  }
  .pcard-cta {
    color: var(--muted);
    font-size: 0.64rem;
    transition: color 0.2s;
  }
  .pcard--link:hover .pcard-cta { color: var(--accent); }
  .pcard-link {
    font-size: 0.62rem;
    color: var(--text-dim);
  }
  .pcard-link:hover { color: var(--accent); }
  .pcard-link.yt:hover { color: #ff5c5c; }
</style>
